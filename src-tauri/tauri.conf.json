{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milo",
  "version": "0.3.0",
  "identifier": "app.milo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Milo",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A calm personal cockpit: calendar, tasks, focus and insights.",
    "publisher": "Milo",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNDA0QTVCQTQ3MTA0MTcKUldRWEJIR2tXMHBBSCtnS3NYci9mUHI3ZmNoSzVIUmdobGVmYmJYb0xMMFlwaUU2SXIxSjQ1bHYK",
      "endpoints": [
        "https://github.com/VR0EM/milo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
