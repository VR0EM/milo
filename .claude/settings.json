{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run check:layout)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git describe:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release view:*)"
    ],
    "deny": [
      "Read(~/.tauri/**)",
      "Bash(cat ~/.tauri/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag -d:*)",
      "Bash(git push origin --delete:*)",
      "Bash(gh secret:*)"
    ]
  }
}
